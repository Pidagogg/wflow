# ============================================================================
# W FLOW — environment configuration
# Copy this file to `.env` and adjust. The server reads it automatically
# (server/env.js) — all values are optional; the app works with defaults.
# ============================================================================

# Port the server listens on (default 3001). Behind a reverse proxy you usually
# keep 3001 and let Caddy / Nginx / Cloudflare Tunnel forward to it.
PORT=3001

# Optional: use PostgreSQL instead of the built-in SQLite for accounts,
# sessions and settings (requires `npm install` to have installed the `pg`
# driver). Unset this to keep the zero-config SQLite backend. Moving an existing
# SQLite installation over — run this once with the app stopped, then set the
# URL here and restart; it copies every table and leaves ./data/admin.db intact
# so removing DATABASE_URL rolls back:
#   npm run db:migrate -- --url postgres://user:password@host:5432/wflow
#   DATABASE_URL=postgres://user:password@host:5432/wflow

# Set to 1 when the app runs behind Cloudflare, Nginx, Caddy or another proxy.
# Express then trusts the X-Forwarded-For header so rate limiting sees the
# real client IP instead of the proxy's IP.
TRUST_PROXY=1

# Encryption key for sensitive values stored in the database (cloud token,
# workflow-node credentials in the workflow_secrets table, etc.). Must be at
# least 32 bytes as hex. If unset, a key is generated and stored in
# ./data/.secret — set this in production and back it up, otherwise encrypted
# values become unreadable if the data directory is lost.
#   BF_ENCRYPTION_KEY=<64 hex chars>

# Admin panel port (separate server, launched via admin.bat / admin.sh).
ADMIN_PORT=3002

# Host the admin panel binds to. The secure default is loopback only. Leave this
# as 127.0.0.1 for AWS and reach it through an SSH tunnel:
#   ssh -L 3002:localhost:3002 user@your-server
# Docker Compose overrides this inside its admin container while publishing the
# host port only on 127.0.0.1.
ADMIN_HOST=127.0.0.1

# Restrict the admin panel to specific IPs — "only from my PC". Comma-separated
# IPs and/or CIDR subnets; everything else gets 403 before the login page.
# Behind a reverse proxy (Cloudflare, Caddy, Nginx) also set TRUST_PROXY=1 so
# the real client IP is used instead of the proxy's.
#   ADMIN_ALLOWED_IPS=203.0.113.7
#   ADMIN_ALLOWED_IPS=203.0.113.0/24,2001:db8::/32

# Credentials used when the admin panel seeds its first admin account on a fresh
# database. If unset the well-known defaults (which are public in the repo) are
# used and a warning is printed — set these on a public deployment.
#   BF_ADMIN_USERNAME=myadmin
#   BF_ADMIN_PASSWORD=change-me-to-something-long

# Optional: where to store the SQLite database file (default ./data/admin.db).
# Mostly useful for tests or multiple instances.
#   BF_DB_PATH=./data/admin.db

# Optional: where to store the JSON data files (workflows.json, agents.json, …),
# default ./data. Mostly useful for tests or multiple instances. Note: where
# WORKFLOWS are saved (device file vs the SQL `workflows` table) is NOT an env
# var — it is the "Workflow storage" toggle on the admin Cloud servers page.
#   BF_DATA_DIR=./data

# Set to 1 to disable the background cron scheduler. The scheduler scans saved
# workflows for Schedule (cron) trigger nodes every 30 s and executes the
# workflow on its own when the cron fires — no manual Run needed. It is on by
# default; disable it if you prefer to trigger everything manually.
#   DISABLE_SCHEDULER=1

# Mark the site's session cookies Secure (HTTPS only). Set to 1 when the site
# is served over TLS (Cloudflare / Caddy / Nginx) so the login cookie is never
# sent over plain HTTP. Leave unset for local http:// development.
#   BF_COOKIE_SECURE=1

# Optional: allow specific cross-origin websites to call the REST API and
# webhooks (comma-separated origins). Default is same-origin only — the UI is
# served by the app itself and the Vite dev server proxies /api and /webhook.
#   BF_CORS_ORIGIN=https://app.example.com

# Webhook rate limit: max /webhook/:id requests per IP per minute (default 60).
# Cheap protection for the one public, unauthenticated endpoint.
#   BF_WEBHOOK_RATE_LIMIT=60
#   BF_MCP_RATE_LIMIT=120        (requests per IP per minute to /mcp, the AI-tools endpoint)

# Allow anyone to create an account on the login page. Default is on (the app
# is behind a login either way). For a private deployment set 0 so only the
# account(s) you create yourself (via the admin panel / SQL console) can log in
# — recommended on a public server so strangers cannot use your compute or
# outbound network through workflows.
#   BF_ALLOW_REGISTER=0

# Block workflow nodes from calling private / link-local / cloud-metadata
# addresses (127.0.0.1, 10.x, 172.16-31.x, 192.168.x, 169.254.x incl. the AWS
# instance-metadata service at 169.254.169.254). Set to 1 on a public
# deployment (EC2 etc.) so a workflow cannot probe the server or its cloud
# account. Off by default so local/internal testing keeps working; set 0 again
# if you deliberately call services on your own network.
#   BF_BLOCK_PRIVATE_URLS=1

# Free-plan caps — Pro (an active Stripe subscription) lifts both. Editor Run
# clicks, webhook calls AND cron-scheduled fires all count toward the daily
# run cap (nested sub-workflow calls never count). Set to 0 to disable a cap.
#   BF_FREE_MAX_WORKFLOWS=10
#   BF_FREE_MAX_RUNS_PER_DAY=50

# My files — every account's own folder for the file nodes
# (data/files/users/<account>). Largest single upload on the My files page,
# and how much one account may store in total by plan (uploads and Write File
# nodes both count), in MB.
#   BF_FILES_MAX_UPLOAD_MB=25
#   BF_FILES_FREE_TOTAL_MB=25
#   BF_FILES_PRO_TOTAL_MB=500

# "Time saved" on the Workspace page is an estimate: every production run (one
# nobody started by hand — webhook, schedule, chat, Telegram) is assumed to
# replace this many minutes of manual work, minus the machine time the run
# itself took. Default 5.
#   BF_MANUAL_MINUTES_PER_RUN=5

# Public domain of this instance — the server swaps it into the YOUR-DOMAIN
# placeholders of the marketing page (/landing.html), robots.txt and
# sitemap.xml when serving them. The value set in the admin panel (Deployment
# → Landing page / SEO domain) takes precedence over this env var.
#   BF_SITE_DOMAIN=flow.example.com

# ---------------------------------------------------------------------------
# Operational alerts, database backups & the events journal
# ---------------------------------------------------------------------------
# Alerts: the admin panel watches the main server's health endpoint and records
# an alert when it stops answering or reports a problem. Set the notification
# e-mail in the admin panel (Alerts tab) — these env vars are the fallback
# defaults. See server/alerts.js.
#   BF_ALERTS=0                    # disable the health monitor entirely
#   BF_ALERT_EMAIL=ops@example.com # default notification address
#   BF_HEALTH_URL=http://127.0.0.1:3001/api/health
#   BF_ALERT_POLL_MS=30000         # how often to check (minimum 5000)
#   BF_ALERT_FAIL_THRESHOLD=2      # failed checks in a row before an alert

# Events journal: every contact with the database is recorded and flushed to the
# `db_events` table in batches (default every 1 s), so it is itself backed up
# with the database. Configure retention and pruning in the admin panel
# (Journal tab). See server/journal.js.
#   BF_JOURNAL=0                   # disable journalling entirely
#   BF_JOURNAL_FLUSH_MS=1000
#   BF_JOURNAL_RETENTION_DAYS=7
#   BF_JOURNAL_SOURCE=server       # label this process in the journal

# Run history: how many days each workflow run (its full log, including data
# returned by connected services) is kept before it is deleted. Default 30;
# 0 keeps runs forever. See server/executions.js.
#   BF_EXECUTION_RETENTION_DAYS=30

# Backups: enable the schedule + interval in the admin panel (Backups tab). A
# backup snapshots the whole ./data folder — the database (SQLite file or a
# PostgreSQL logical dump), the events journal, the JSON stores, uploaded files
# and the encryption keyfile — into ./data/backups/ and packs it as .tar.gz.
# See server/backup.js.

# SMTP — transactional e-mail for password reset and e-mail verification. All
# optional; also editable in the admin panel (Auth & e-mail tab), where admin
# values win over these. Without an SMTP host the links are logged to the
# server console so local development still works.
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=0            # 1 for implicit TLS on port 465
#   SMTP_USER=apikey
#   SMTP_PASS=your-smtp-password
#   MAIL_FROM=W flow <no-reply@example.com>
# With an SMTP host set, a password sign-up must open the e-mailed confirmation
# link before it can log in (admins are exempt). Set 0 to allow unconfirmed
# logins anyway. Without SMTP the check is always off.
#   BF_REQUIRE_EMAIL_VERIFY=1
# Throttle for confirmation / resend / password-reset mails: one per address
# per BF_MAIL_COOLDOWN_SECONDS (default 60), and at most BF_MAIL_IP_LIMIT per IP
# per 10 minutes (default 5). Only applies while SMTP is configured.
#   BF_MAIL_COOLDOWN_SECONDS=60
#   BF_MAIL_IP_LIMIT=5
# Contact form (Settings → Contact): messages one account may send in any
# rolling hour. Rejected submissions (empty, invalid address) do not count.
#   BF_CONTACT_PER_HOUR=3

# External origin used to build e-mail links and OAuth redirect URIs when the
# app runs behind a proxy / tunnel. Defaults to the request's own host.
#   BF_PUBLIC_URL=https://flow.example.com

# OAuth login (optional). Set BOTH values of a provider to offer its button on
# the login card. These are normally configured in the admin panel (Auth &
# e-mail tab), which stores the secret encrypted at rest — panel values win over
# these env vars. Redirect URI: <BF_PUBLIC_URL>/api/auth/oauth/<provider>/callback
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   GITHUB_CLIENT_ID=...
#   GITHUB_CLIENT_SECRET=...

# Connected accounts for nodes ("Connect Google" / "Connect Microsoft" on the
# Gmail, Drive, Sheets, Outlook, OneDrive, … nodes — no passwords or pasted
# tokens). Google reuses GOOGLE_CLIENT_ID/SECRET above: add
# <BF_PUBLIC_URL>/api/connections/google/callback as a redirect URI and enable
# the APIs (Gmail, Drive, Sheets, …) in the Google Cloud project. Microsoft
# needs an Entra app registration with redirect URI
# <BF_PUBLIC_URL>/api/connections/microsoft/callback. Also editable in the
# admin panel (Auth & e-mail).
# Off a self-hosted copy (WFLOW_STANDALONE), Google is only asked for the
# scopes the cloud's client is verified for (shared/oauth.js
# GOOGLE_VERIFIED_SCOPES); the other Google nodes keep their pasted-token
# field. Set this when your Google client may use every scope:
#   GOOGLE_ALL_SCOPES=1
#   MICROSOFT_CLIENT_ID=...
#   MICROSOFT_CLIENT_SECRET=...
#   MICROSOFT_TENANT=common
#
# The same pattern works for every other connected-account service —
# <ID>_CLIENT_ID / <ID>_CLIENT_SECRET with ID one of GITLAB, SLACK, NOTION,
# DROPBOX, HUBSPOT, AIRTABLE, ASANA, LINEAR, TODOIST, ZOOM, LINKEDIN, X, BOX,
# CALENDLY, TYPEFORM, WEBFLOW, PINTEREST, INTERCOM, SALESFORCE, SURVEYMONKEY,
# XERO, QUICKBOOKS. Redirect URI: <BF_PUBLIC_URL>/api/connections/<id>/callback
# (lower-case id). GitHub reuses GITHUB_CLIENT_ID/SECRET — keep that app's
# callback URL at <BF_PUBLIC_URL>/api/auth/oauth/github/callback; the connect
# redirect (…/callback/connect) sits below it, which GitHub accepts. The admin
# panel (Auth & e-mail → More connected accounts) lists each service with a
# link to its developer console.

# Telegram personal-account logins ("Connect as: My Telegram account" on the
# Telegram nodes). Register ONE app for this site at my.telegram.org → API
# development tools; users then connect with just their phone number. Without
# it every user has to paste their own API ID + hash. Normally set in the admin
# panel (Auth & e-mail → Telegram); these are the fallback.
#   TELEGRAM_API_ID=1234567
#   TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Supabase login (optional) — a second front door to the same accounts. Users sign
# in through a provider Supabase runs (Google, GitHub, Discord, Apple, LinkedIn,
# Slack, …) or with a passwordless e-mail link. Supabase only proves the e-mail
# address: the account, its workflows, quotas and encrypted credentials stay in
# this app's own database, exactly as with the Google / GitHub buttons above.
#
# Normally configured in the admin panel (Auth & e-mail tab), which stores the key
# encrypted at rest — these env vars are the fallback. Setup walkthrough with the
# Supabase dashboard steps: docs/supabase.md
#   SUPABASE_URL=https://abcdefgh.supabase.co   # Project Settings → API
#   SUPABASE_ANON_KEY=sb_publishable_…          # the PUBLIC key (never sent to the browser)
#   SUPABASE_PROVIDERS=google,discord,apple     # one button per provider on the login card
#   SUPABASE_MAGIC_LINK=0                       # 0 hides the “e-mail me a sign-in link” form

# When on, password-reset / verification links are returned in the API response
# instead of (only) being e-mailed. Intended for tests and local setup — leave
# off in production.
#   BF_EXPOSE_RESET_LINK=1

# Legal pages — Impressum and Datenschutzerklärung (there is no AGB / terms
# page) are served at /impressum and /datenschutz, and optionally as a separate
# site on their own subdomain, by default info.<BF_SITE_DOMAIN> (or
# info.<site.domain> from the admin panel). Set the exact host here to override,
# or use the admin panel → Legal pages tab (its value wins over this env var).
#   BF_LEGAL_DOMAIN=info.example.com

# Operator details rendered into the Impressum and the privacy policy (in
# German, English and Russian). Also editable in the admin panel (Legal pages
# tab) — admin values win over these. Until set, the pages show clearly marked
# placeholders ([First and last name] …).
#
# Name and address of the operator (a private person can leave the commercial
# fields empty — those rows then disappear from the Impressum):
#   LEGAL_NAME=Max Mustermann
#   LEGAL_COMPANY=Example GmbH
#   LEGAL_LEGAL_FORM=GmbH
#   LEGAL_ADDRESS=Musterstraße 1
#   LEGAL_CITY=12345 Musterstadt
#   LEGAL_COUNTRY=Deutschland
#   LEGAL_EMAIL=hello@example.com
#   LEGAL_PHONE=+49 30 123456
#   LEGAL_REPRESENTATIVE=Max Mustermann
#   LEGAL_REGISTER_COURT=Amtsgericht Musterstadt
#   LEGAL_REGISTER_NUMBER=HRB 12345
#   LEGAL_VAT_ID=DE123456789
#   LEGAL_PRIVACY_EMAIL=privacy@example.com
#   LEGAL_REPORT_EMAIL=abuse@example.com
#
# Privacy policy (Datenschutz) placeholders — all optional. An empty value
# hides its line (and an empty section, e.g. third-country transfers, entirely).
#   LEGAL_UPDATED=September 2026
#   LEGAL_SITE_DOMAIN=flow.example.com
#   LEGAL_LOG_RETENTION=7 Tage
#   LEGAL_HOSTER=Hetzner Online GmbH
#   LEGAL_HOSTER_ADDRESS=Industriestr. 25, 91710 Gunzenhausen
#   LEGAL_HOSTING_LOCATION=Nürnberg, Deutschland
#   LEGAL_CLOUDFLARE=Free plan, proxy mode, WAF enabled
#   LEGAL_SUPABASE=Supabase project eu-central-1 (Supabase Auth)
#   LEGAL_DATABASE=PostgreSQL on our own server in Nürnberg, Deutschland
#   LEGAL_MAIL_SERVICE=own SMTP server
#   LEGAL_STORAGE_PERIODS=Rechnungsdaten: 10 Jahre
#   LEGAL_EXTRA_USER_FIELDS=Benutzername, Anzeigename
#   LEGAL_ACCOUNT_DELETION=die Kontoeinstellungen
#   LEGAL_WORKFLOW_STORAGE=verschlüsselt in einer Datenbank
#   LEGAL_EXTERNAL_DATA=Beschreibung, welche Daten bei externen Aufrufen an wen fließen
#   LEGAL_SESSION_TECH=technisch notwendige Session-Cookies
#   LEGAL_SESSION_DURATION=30 Tage bei "Angemeldet bleiben"
#   LEGAL_PROCESSORS=Stripe (Zahlungsabwicklung), SMTP-Versand
#   LEGAL_THIRD_COUNTRY_SERVICE=Stripe, USA
#   LEGAL_THIRD_COUNTRY_BASIS=EU-US Data Privacy Framework
#   LEGAL_AUTHORITY=Der Landesbeauftragte für den Datenschutz …
#   LEGAL_SECURITY_MEASURES=Zugriffsbeschränkungen, regelmäßige Backups

# SEO & GEO — the search-engine and generative-engine (AI answer engines)
# settings. Also editable in the admin panel (SEO & GEO tab) — admin values win.
# They are injected into index.html / landing.html, and generate robots.txt and
# /llms.txt at request time; BF_SITE_DOMAIN is the public host used for the
# canonical and og:url tags.
#   BF_SEO_TITLE=W flow — Self-hosted workflow & AI agent builder
#   BF_SEO_DESCRIPTION=Self-hosted visual workflow builder with AI agents.
#   BF_SEO_KEYWORDS=workflow automation, self-hosted, n8n alternative
#   BF_SEO_OG_IMAGE=https://example.com/og.png
#   BF_SEO_TWITTER=@yourhandle
#   BF_SEO_INDEX=0                        # 0 sends noindex,nofollow + Disallow: /
#   BF_SEO_GOOGLE_VERIFICATION=…          # google-site-verification content value
#   BF_SEO_BING_VERIFICATION=…            # msvalidate.01 content value
#   BF_SEO_ROBOTS_EXTRA=User-agent: SemrushBot\nDisallow: /
#   BF_SEO_EXTRA_HEAD=<meta name="…" content="…" />
#   BF_GEO_LLMS=0                         # 0 stops publishing /llms.txt
#   BF_GEO_AI_CRAWLERS=0                  # 0 disallows GPTBot / ClaudeBot / … in robots.txt
#   BF_GEO_SUMMARY=W flow is a self-hosted workflow automation and AI agent builder…
#   BF_GEO_FACTS=Self-hosted: data stays on your server\nBrings your own AI model keys

# Crypto payments (NOWPayments) — the card-free way to buy the same Pro plan.
# Also editable in the admin panel (Billing tab → Crypto); leave the API key
# blank to keep paying by card only.
#   NOWPAYMENTS_API_KEY=…
#   NOWPAYMENTS_IPN_SECRET=…

# Custom Team plan (server/teams.js) — requests from the Pro page are e-mailed
# here and can only be bought after you approve them in the admin panel
# (Team plans tab). ADMIN_PUBLIC_URL is the admin-panel link in that e-mail.
#   TEAM_REQUESTS_EMAIL=main@w-flow.tech
#   ADMIN_PUBLIC_URL=https://admin.example.com

# Self-hosted licence (server/license.js) — set on a COPY by the installer, or
# pasted on its lock screen / Setup page. The copy sends only this key to the
# licence server every few hours and locks once the Pro / Team plan has ended.
#   WFLOW_LICENSE_KEY=wfl_…
#   WFLOW_LICENSE_SERVER=https://w-flow.tech
