# STRATO VPS access for deploy/deploy.sh.
# Copy to deploy/vps.env (git-ignored) and fill in the values from the STRATO
# customer area → Server → your VPS → "Zugangsdaten" (access data).

# Public IPv4 address of the VPS
VPS_HOST=
# SSH user (STRATO VPS: root)
VPS_USER=root
# SSH port (default 22)
VPS_PORT=22
# Where the app lives on the server
VPS_DIR=/opt/wflow
# Optional: path to your SSH private key. Leave empty to be asked for the
# root password STRATO gave you.
VPS_SSH_KEY=
