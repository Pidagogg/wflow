# ============================================================================
# W FLOW — production settings for https://w-flow.tech (STRATO VPS)
#
# deploy/strato-setup.sh copies this file to .env on the server and fills in
# the generated secrets (encryption key, admin password). Everything else is
# pre-set for w-flow.tech — only the lines marked FILL IN need your data.
# See docs/strato-vps.md for the full walkthrough.
# ============================================================================

PORT=3001

# --- Domain -----------------------------------------------------------------
# Caddy fetches the HTTPS certificates for these hosts automatically.
SITE_ADDRESS=w-flow.tech, www.w-flow.tech, info.w-flow.tech
BF_SITE_DOMAIN=w-flow.tech
BF_PUBLIC_URL=https://w-flow.tech
# Legal pages also answer on their own subdomain (https://info.w-flow.tech).
BF_LEGAL_DOMAIN=info.w-flow.tech

# --- Behind the Caddy proxy -------------------------------------------------
# The app is only reachable through Caddy (ports 80/443), never directly.
APP_BIND=127.0.0.1
TRUST_PROXY=1
BF_COOKIE_SECURE=1
BF_BLOCK_PRIVATE_URLS=1

# --- Secrets (generated by deploy/strato-setup.sh — keep them safe) --------
BF_ENCRYPTION_KEY=
BF_ADMIN_USERNAME=admin
BF_ADMIN_PASSWORD=

# Admin panel: loopback only — open it through an SSH tunnel:
#   ssh -L 3002:127.0.0.1:3002 root@<VPS-IP>   →  http://localhost:3002
ADMIN_PORT=3002
ADMIN_HOST=127.0.0.1

# --- E-mail (checkdomain mailbox of the domain) -----------------------------
# The domain and its mailbox live at checkdomain, not STRATO. Create the mailbox
# main@w-flow.tech at checkdomain (E-Mails → Server-Informationen lists the
# SMTP host), then FILL IN SMTP_PASS with the mailbox password
# (port 465 = SSL/TLS). Until SMTP_PASS is set, mail counts as not configured:
# sign-ups work without the confirmation e-mail and links are only logged.
SMTP_HOST=host268.checkdomain.de
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=main@w-flow.tech
SMTP_PASS=
MAIL_FROM=W flow <main@w-flow.tech>
# One confirmation / reset mail per address per minute, 5 per IP per 10 minutes.
BF_MAIL_COOLDOWN_SECONDS=60
BF_MAIL_IP_LIMIT=5
# Contact form: 3 messages per account per hour.
BF_CONTACT_PER_HOUR=3
BF_ALERT_EMAIL=

# --- Connected accounts for nodes (Connect Google / Connect Microsoft) -----
# Google nodes reuse the Google login client (GOOGLE_CLIENT_ID/SECRET or the
# admin panel); add https://w-flow.tech/api/connections/google/callback to its
# redirect URIs. Microsoft nodes need an Entra app registration with redirect
# URI https://w-flow.tech/api/connections/microsoft/callback. Both can also be
# set in the admin panel (Auth & e-mail) instead of here.
# Google is only asked for the scopes the client is verified for
# (shared/oauth.js GOOGLE_VERIFIED_SCOPES). Leave this unset in production
# unless the Cloud Console's Data Access list covers every Google node.
# GOOGLE_ALL_SCOPES=1
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Every other service (GitLab, Slack, Notion, Dropbox, HubSpot, Airtable, …)
# follows the same pattern, e.g. SLACK_CLIENT_ID / SLACK_CLIENT_SECRET with
# redirect URI https://w-flow.tech/api/connections/slack/callback — easier to
# fill in through the admin panel (Auth & e-mail → More connected accounts).

# Telegram personal-account logins: ONE app for the site from my.telegram.org →
# API development tools, so users connect with only their phone number. Easier
# to fill in through the admin panel (Auth & e-mail → Telegram).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# My files (the per-account folder the Write/Read/List File nodes use):
# largest single upload, and how much one account may store in total by plan
# (uploads and Write File nodes both count), in MB.
BF_FILES_MAX_UPLOAD_MB=25
BF_FILES_FREE_TOTAL_MB=25
BF_FILES_PRO_TOTAL_MB=500

# --- Legal pages (Impressum / Datenschutz) ----------------------------------
# Hosting is pre-filled with STRATO. FILL IN your own details below — values
# set in the admin panel's "Legal pages" tab take precedence over these.
LEGAL_SITE_DOMAIN=w-flow.tech
LEGAL_HOSTER=STRATO GmbH
LEGAL_HOSTER_ADDRESS=Otto-Ostrowski-Straße 7, 10249 Berlin, Deutschland
LEGAL_HOSTING_LOCATION=Deutschland (STRATO-Rechenzentrum)
LEGAL_DATABASE=SQLite-Datenbank auf dem eigenen STRATO-VPS in Deutschland
LEGAL_MAIL_SERVICE=checkdomain GmbH (E-Mail-Postfach der Domain w-flow.tech)
LEGAL_PROCESSORS=STRATO GmbH (Hosting), checkdomain GmbH (Domain, E-Mail-Versand)
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_REPORT_EMAIL=
LEGAL_UPDATED=September 2026

# Run history retention in days (each run's full log, including data returned
# by connected services). Default 30; 0 keeps runs forever.
BF_EXECUTION_RETENTION_DAYS=30
